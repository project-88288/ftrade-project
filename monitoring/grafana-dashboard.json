{
  "title": "ftrade — Trading",
  "uid": "ftrade-trading",
  "tags": ["ftrade", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Realized PnL (net)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "ftrade_realized_pnl", "datasource": { "type": "prometheus", "uid": "${datasource}" } }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Win rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 55 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "ftrade_win_rate_percent", "datasource": { "type": "prometheus", "uid": "${datasource}" } }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total trades",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "ftrade_trades_total", "datasource": { "type": "prometheus", "uid": "${datasource}" } }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Open positions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "ftrade_open_positions", "datasource": { "type": "prometheus", "uid": "${datasource}" } }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Realized PnL over time",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "ftrade_realized_pnl", "legendFormat": "net", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "B", "expr": "ftrade_realized_gross_pnl", "legendFormat": "gross", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "C", "expr": "ftrade_fees_total", "legendFormat": "fees", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Trades: wins vs losses",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "ftrade_wins_total", "legendFormat": "wins", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "B", "expr": "ftrade_losses_total", "legendFormat": "losses", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Open positions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "expr": "ftrade_position_entry_price", "format": "table", "instant": true, "legendFormat": "entry", "datasource": { "type": "prometheus", "uid": "${datasource}" } },
        { "refId": "B", "expr": "ftrade_position_amount", "format": "table", "instant": true, "legendFormat": "amount", "datasource": { "type": "prometheus", "uid": "${datasource}" } }
      ]
    }
  ]
}
