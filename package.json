{
  "name": "ftrade-project",
  "version": "0.1.0",
  "description": "TypeScript trading bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "backtest": "tsx src/backtest/run.ts",
    "optimize": "tsx src/backtest/optimize-run.ts",
    "traintest": "tsx src/backtest/traintest-run.ts",
    "pnl": "tsx src/state/pnl-report.ts",
    "dashboard": "tsx src/dashboard/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "trading",
    "bot",
    "crypto",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ccxt": "^4.4.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
