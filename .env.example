# Exchange API credentials
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# Trading configuration
# Single default market (used by the backtest/optimize CLIs)
SYMBOL=BTC/USDT
# Markets the live bot trades concurrently (comma-separated; falls back to SYMBOL)
SYMBOLS=BTC/USDT
TIMEFRAME=1m
# Set to "true" to run against the exchange sandbox / testnet
SANDBOX=true
# Set to "true" to log intended trades without sending real orders
DRY_RUN=true

# Market type: spot | future (USDT-margined perpetuals)
MARKET_TYPE=spot
# Leverage and margin mode applied to futures positions (isolated | cross)
LEVERAGE=1
MARGIN_MODE=isolated
# Fraction of quote balance used as MARGIN per trade (0.20 = 20%); 0 disables.
# When >0 this overrides MAX_POSITION_USD: notional = balance * POSITION_PCT * LEVERAGE.
POSITION_PCT=0

# Risk management
MAX_POSITION_USD=100
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
# Fee rate used only to estimate fees for DRY_RUN orders (0.001 = 0.1%).
# Real orders report their actual fees from the exchange.
FEE_RATE=0.001

# Strategy selection: sma | ema | rsi | macd | bollinger | stochastic | donchian | trendbreak
STRATEGY=sma
# Optional per-symbol overrides as JSON (unset fields fall back to the global config)
# SYMBOL_STRATEGIES={"BTC/USDT":{"strategy":"ema","fast":12,"slow":26},"ETH/USDT":{"strategy":"rsi"}}
SYMBOL_STRATEGIES=
# Crossover strategies (sma, ema) and MACD fast/slow
FAST_PERIOD=9
SLOW_PERIOD=21
# MACD signal-line EMA period
MACD_SIGNAL=9
# RSI strategy
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
# Bollinger Bands: lookback period and standard-deviation multiplier
BB_PERIOD=20
BB_STDDEV=2
# Stochastic oscillator: %K lookback and %D smoothing (uses RSI_OVERSOLD/OVERBOUGHT)
STOCH_K=14
STOCH_D=3
# Donchian channel breakout lookback (also the breakout channel for trendbreak)
DONCHIAN_PERIOD=20
# Trend-filtered breakout: long-term SMA period used as the trend filter
TREND_PERIOD=100

# How often the bot polls the exchange (seconds)
POLL_INTERVAL_SEC=15

# Where the bot persists its open position (survives restarts)
STATE_FILE=./state.json

# Append-only log of closed trades with realized PnL (view with: npm run pnl)
TRADE_LOG_FILE=./trades.jsonl

# On startup, reconcile the persisted position against the exchange balance
# (needs live API credentials; skipped in DRY_RUN).
RECONCILE=true
# Relative tolerance when matching amounts (0.02 = 2%)
RECONCILE_TOLERANCE=0.02
# Base-asset amount at or below which a balance is treated as dust (flat)
RECONCILE_DUST=0

# Telegram alerts on fills — set both to enable (leave blank to disable).
# Create a bot with @BotFather for the token; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web dashboard for the PnL log (npm run dashboard)
DASHBOARD_PORT=3000

# Logging
LOG_LEVEL=info
